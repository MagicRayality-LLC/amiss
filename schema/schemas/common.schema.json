{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Amiss shared contract records",
  "$defs": {
    "ContractVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Scalar": {
      "anyOf": [
        {"type": "number"},
        {"type": "string"},
        {"type": "boolean"}
      ]
    },
    "TrialRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trial_id", "trial_revision"],
      "properties": {
        "trial_id": {"$ref": "#/$defs/Identifier"},
        "trial_revision": {"type": "integer", "minimum": 1}
      }
    },
    "NullableTrialRef": {
      "anyOf": [
        {"$ref": "#/$defs/TrialRef"},
        {"type": "null"}
      ]
    },
    "ExistingTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "trial_ref"],
      "properties": {
        "kind": {"const": "existing"},
        "trial_ref": {"$ref": "#/$defs/TrialRef"}
      }
    },
    "NewTrialTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "episode_id", "source_trial_ref"],
      "properties": {
        "kind": {"const": "new_trial"},
        "episode_id": {"$ref": "#/$defs/Identifier"},
        "source_trial_ref": {"$ref": "#/$defs/NullableTrialRef"}
      }
    },
    "Target": {
      "oneOf": [
        {"$ref": "#/$defs/ExistingTarget"},
        {"$ref": "#/$defs/NewTrialTarget"}
      ]
    },
    "Citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_id", "trial_ref"],
      "properties": {
        "measurement_id": {"$ref": "#/$defs/Identifier"},
        "trial_ref": {"$ref": "#/$defs/TrialRef"},
        "display_tuple_id": {"$ref": "#/$defs/Identifier"}
      }
    },
    "TargetParameters": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {"$ref": "#/$defs/Identifier"},
      "additionalProperties": {"$ref": "#/$defs/Scalar"}
    },
    "InputDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_id", "to_value", "downstream_effect_ids"],
      "properties": {
        "parameter_id": {"$ref": "#/$defs/Identifier"},
        "to_value": {"$ref": "#/$defs/Scalar"},
        "unit": {"$ref": "#/$defs/Identifier"},
        "from_value": {"$ref": "#/$defs/Scalar"},
        "downstream_effect_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/Identifier"}
        }
      }
    },
    "ContractVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework_api_version",
        "snapshot_envelope_version",
        "tool_schema_version",
        "save_format_version"
      ],
      "properties": {
        "framework_api_version": {"$ref": "#/$defs/ContractVersion"},
        "snapshot_envelope_version": {"$ref": "#/$defs/ContractVersion"},
        "tool_schema_version": {"$ref": "#/$defs/ContractVersion"},
        "save_format_version": {"$ref": "#/$defs/ContractVersion"}
      }
    },
    "TrialIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "episode_id",
        "episode_model_version",
        "episode_module_version",
        "app_build_version",
        "contract_versions",
        "source_trial_ref"
      ],
      "properties": {
        "trial_id": {"$ref": "#/$defs/Identifier"},
        "episode_id": {"$ref": "#/$defs/Identifier"},
        "episode_model_version": {"$ref": "#/$defs/ContractVersion"},
        "episode_module_version": {"$ref": "#/$defs/ContractVersion"},
        "app_build_version": {"$ref": "#/$defs/Identifier"},
        "contract_versions": {"$ref": "#/$defs/ContractVersions"},
        "source_trial_ref": {"$ref": "#/$defs/NullableTrialRef"}
      }
    },
    "TrialState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "acceptance",
        "activity",
        "terminal_reason",
        "trial_revision",
        "tick"
      ],
      "properties": {
        "phase": {
          "enum": [
            "setup",
            "predicted",
            "skipped",
            "baseline",
            "intervention",
            "settling",
            "measured",
            "archived",
            "abandoned"
          ]
        },
        "acceptance": {"enum": ["not_applicable", "proposed", "accepted"]},
        "activity": {"enum": ["running", "paused"]},
        "terminal_reason": {
          "anyOf": [
            {"$ref": "#/$defs/Identifier"},
            {"type": "null"}
          ]
        },
        "trial_revision": {"type": "integer", "minimum": 1},
        "tick": {"type": "integer", "minimum": 0}
      }
    },
    "GuideProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "satisfied_evidence_fact_ids",
        "policy_version",
        "trial_ref"
      ],
      "properties": {
        "stage_id": {"$ref": "#/$defs/Identifier"},
        "satisfied_evidence_fact_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/Identifier"}
        },
        "policy_version": {"$ref": "#/$defs/Identifier"},
        "trial_ref": {"$ref": "#/$defs/TrialRef"}
      }
    },
    "PolicyToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_id", "kind", "value_id"],
      "properties": {
        "token_id": {"$ref": "#/$defs/Identifier"},
        "kind": {
          "enum": [
            "stage",
            "proactive_candidate",
            "solicitation",
            "allowed_action",
            "setup_family",
            "policy_version"
          ]
        },
        "value_id": {"$ref": "#/$defs/Identifier"},
        "solicitation_kind": {"enum": ["answer", "prediction"]}
      }
    },
    "PolicyTokenSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "stage_id",
        "policy_version",
        "refs",
        "tokens"
      ],
      "properties": {
        "episode_id": {"$ref": "#/$defs/Identifier"},
        "stage_id": {"$ref": "#/$defs/Identifier"},
        "policy_version": {"$ref": "#/$defs/Identifier"},
        "refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/TrialRef"}
        },
        "tokens": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/PolicyToken"}
        }
      }
    },
    "PredictionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prediction_id",
        "gate_id",
        "subject_trial_ref",
        "target_trial_ref",
        "choice_id",
        "skipped",
        "readout_masked",
        "measurement_id"
      ],
      "properties": {
        "prediction_id": {"$ref": "#/$defs/Identifier"},
        "gate_id": {"$ref": "#/$defs/Identifier"},
        "subject_trial_ref": {"$ref": "#/$defs/TrialRef"},
        "target_trial_ref": {"$ref": "#/$defs/TrialRef"},
        "choice_id": {
          "anyOf": [
            {"$ref": "#/$defs/Identifier"},
            {"type": "null"}
          ]
        },
        "skipped": {"type": "boolean"},
        "readout_masked": {"type": "boolean"},
        "measurement_id": {
          "anyOf": [
            {"$ref": "#/$defs/Identifier"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
