{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recorded-call-fixture.schema.json",
  "title": "Amiss sanitized RecordedCallFixture envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_format_version",
    "scenario_id",
    "policy_version",
    "contract_versions",
    "deterministic_recipe",
    "request",
    "response",
    "provenance",
    "integrity"
  ],
  "properties": {
    "fixture_format_version": {"$ref": "common.schema.json#/$defs/ContractVersion"},
    "scenario_id": {"$ref": "common.schema.json#/$defs/Identifier"},
    "policy_version": {"$ref": "common.schema.json#/$defs/Identifier"},
    "contract_versions": {"$ref": "#/$defs/ContractVersions"},
    "deterministic_recipe": {"$ref": "#/$defs/DeterministicRecipe"},
    "request": {"$ref": "#/$defs/SanitizedRequest"},
    "response": {"$ref": "#/$defs/StructuredResponse"},
    "provenance": {"$ref": "model-provenance.schema.json"},
    "integrity": {"$ref": "#/$defs/Integrity"}
  },
  "$defs": {
    "ContractVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework_api_version",
        "snapshot_envelope_version",
        "tool_schema_version",
        "save_format_version",
        "stage_data_format_version",
        "context_payload_version",
        "fixture_format_version",
        "provenance_contract_version",
        "episode_model_version"
      ],
      "properties": {
        "framework_api_version": {"$ref": "common.schema.json#/$defs/ContractVersion"},
        "snapshot_envelope_version": {"$ref": "common.schema.json#/$defs/ContractVersion"},
        "tool_schema_version": {"$ref": "common.schema.json#/$defs/ContractVersion"},
        "save_format_version": {"$ref": "common.schema.json#/$defs/ContractVersion"},
        "stage_data_format_version": {"$ref": "common.schema.json#/$defs/ContractVersion"},
        "context_payload_version": {"$ref": "common.schema.json#/$defs/ContractVersion"},
        "fixture_format_version": {"$ref": "common.schema.json#/$defs/ContractVersion"},
        "provenance_contract_version": {"$ref": "common.schema.json#/$defs/ContractVersion"},
        "episode_model_version": {"$ref": "common.schema.json#/$defs/ContractVersion"}
      }
    },
    "DeterministicRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_id", "seed", "initial_trial_ref", "stage_id", "input_event_ids"],
      "properties": {
        "episode_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "seed": {"type": "integer", "minimum": 0},
        "initial_trial_ref": {"$ref": "common.schema.json#/$defs/TrialRef"},
        "stage_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "input_event_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/Identifier"}
        }
      }
    },
    "SanitizedRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_contract_version",
        "turn_id",
        "request_id",
        "origin",
        "model",
        "refs",
        "context_payload",
        "policy_envelope"
      ],
      "properties": {
        "request_contract_version": {"$ref": "common.schema.json#/$defs/ContractVersion"},
        "turn_id": {
          "anyOf": [
            {"$ref": "common.schema.json#/$defs/Identifier"},
            {"type": "null"}
          ]
        },
        "request_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "origin": {"enum": ["answer", "proactive", "guide_default"]},
        "model": {"const": "muse-spark-1.3"},
        "refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"$ref": "common.schema.json#/$defs/TrialRef"}
        },
        "context_payload": {"$ref": "context-payload.schema.json"},
        "policy_envelope": {"$ref": "#/$defs/PolicyEnvelope"}
      }
    },
    "PolicyEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "system"],
      "properties": {
        "policy_version": {"$ref": "common.schema.json#/$defs/Identifier"},
        "system": {"type": "string", "maxLength": 65536}
      }
    },
    "StructuredResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_contract_version", "request_id", "refs", "speech_units", "tool_proposals"],
      "properties": {
        "response_contract_version": {"$ref": "common.schema.json#/$defs/ContractVersion"},
        "request_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"$ref": "common.schema.json#/$defs/TrialRef"}
        },
        "speech_units": {
          "type": "array",
          "maxItems": 2,
          "items": {"$ref": "#/$defs/SpeechUnit"}
        },
        "tool_proposals": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "tool-proposal.schema.json"}
        }
      }
    },
    "SpeechUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "turn_id",
        "operation",
        "refs",
        "source_global_revision",
        "text",
        "citations",
        "queue_epoch",
        "completion"
      ],
      "properties": {
        "unit_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "turn_id": {
          "anyOf": [
            {"$ref": "common.schema.json#/$defs/Identifier"},
            {"type": "null"}
          ]
        },
        "operation": {"enum": ["answer", "proactive", "safety"]},
        "refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"$ref": "common.schema.json#/$defs/TrialRef"}
        },
        "source_global_revision": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "maxLength": 4096},
        "citations": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "common.schema.json#/$defs/Citation"}
        },
        "candidate_token_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "solicitation_token_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "queue_epoch": {"type": "integer", "minimum": 0},
        "completion": {"enum": ["pending", "completed", "interrupted", "expired", "suppressed"]}
      }
    },
    "Integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"$ref": "common.schema.json#/$defs/Sha256"}
      }
    }
  }
}
