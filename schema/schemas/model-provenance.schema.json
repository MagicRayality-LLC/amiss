{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-provenance.schema.json",
  "title": "Amiss closed ModelProvenance record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model",
    "endpoint_host",
    "request_id",
    "ts_start",
    "ts_end",
    "input_tokens",
    "output_tokens",
    "prompt_hash",
    "response_hash",
    "mode"
  ],
  "properties": {
    "model": {"const": "muse-spark-1.3"},
    "endpoint_host": {"const": "api.meta.ai"},
    "request_id": {"$ref": "common.schema.json#/$defs/Identifier"},
    "ts_start": {"$ref": "#/$defs/UtcTimestamp"},
    "ts_end": {"$ref": "#/$defs/UtcTimestamp"},
    "input_tokens": {"$ref": "#/$defs/NullableTokenCount"},
    "output_tokens": {"$ref": "#/$defs/NullableTokenCount"},
    "prompt_hash": {"$ref": "common.schema.json#/$defs/Sha256"},
    "response_hash": {"$ref": "common.schema.json#/$defs/Sha256"},
    "mode": {"enum": ["live", "recorded"]}
  },
  "$defs": {
    "UtcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "NullableTokenCount": {
      "anyOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    }
  }
}
