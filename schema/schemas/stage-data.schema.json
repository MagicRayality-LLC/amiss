{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-data.schema.json",
  "title": "Amiss mechanical StageDataEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage_data_format_version",
    "policy_version",
    "episode_id",
    "integrity",
    "stage_graph",
    "evidence_flag_definitions",
    "allowed_action_set"
  ],
  "properties": {
    "stage_data_format_version": {"$ref": "common.schema.json#/$defs/ContractVersion"},
    "policy_version": {"$ref": "common.schema.json#/$defs/Identifier"},
    "episode_id": {"$ref": "common.schema.json#/$defs/Identifier"},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "status"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"$ref": "common.schema.json#/$defs/Sha256"},
        "status": {"enum": ["verified", "corrupt", "incompatible"]}
      }
    },
    "stage_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_stage_id", "nodes"],
      "properties": {
        "initial_stage_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/StageNode"}
        }
      }
    },
    "evidence_flag_definitions": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/EvidenceFlag"}
    },
    "allowed_action_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_ids"],
      "properties": {
        "action_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/Identifier"}
        }
      }
    }
  },
  "$defs": {
    "StageNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "default_path_id",
        "evidence_pair_rules",
        "user_controls",
        "terminal"
      ],
      "properties": {
        "stage_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "default_path_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "evidence_pair_rules": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/EvidencePairRule"}
        },
        "user_controls": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["skip", "replay", "free_exploration"]}
        },
        "terminal": {"type": "boolean"}
      }
    },
    "EvidenceFlag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_kind", "fact_class", "measurement_path_id"],
      "properties": {
        "fact_kind": {"$ref": "common.schema.json#/$defs/Identifier"},
        "fact_class": {"enum": ["action", "state", "prediction"]},
        "measurement_path_id": {"$ref": "common.schema.json#/$defs/Identifier"}
      }
    },
    "EvidencePairRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "first_fact_kind", "second_fact_kind"],
      "properties": {
        "rule_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "first_fact_kind": {"$ref": "common.schema.json#/$defs/Identifier"},
        "second_fact_kind": {"$ref": "common.schema.json#/$defs/Identifier"}
      }
    }
  }
}
